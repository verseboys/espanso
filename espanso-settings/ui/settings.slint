import { Button, LineEdit, TextEdit, VerticalBox, HorizontalBox, ScrollView, ComboBox } from "std-widgets.slint";

export struct MatchRow {
    id: string,
    title: string,
    trigger: string,
    preview: string,
    category: string,
    // Empty for matches Settings owns; the file path for everything else.
    source-path: string,
    source-label: string,
    note: string,
    editable: bool,
}

export component SettingsWindow inherits Window {
    title: "Espanso Settings";
    preferred-width: 1040px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 560px;
    background: #f5f7fb;
    // Explicit CJK-capable face: Slint's Latin-first default often draws Chinese
    // as empty boxes (□) on Windows when only Segoe UI is selected.
    // "Microsoft YaHei" is present on Chinese Windows and language-pack installs.
    default-font-family: "Microsoft YaHei";
    default-font-size: 14px;

    in property <string> config-path;
    in property <string> source-label;
    in property <bool> can-change-location: true;
    in-out property <int> active-tab: 0;
    in-out property <string> selected-path;
    in-out property <string> migration-summary;
    in-out property <bool> migration-ready: false;
    in-out property <string> import-summary;
    in-out property <bool> import-ready: false;
    in-out property <bool> advanced-open: false;
    in-out property <string> status-message: "Ready";
    in-out property <string> error-message;
    in-out property <bool> confirm-discard-visible: false;
    in-out property <bool> undo-visible: false;
    in-out property <string> selected-id;
    in-out property <string> filter-text;
    in-out property <string> short-name-text;
    in-out property <string> trigger-text;
    in-out property <string> replacement-text;
    in-out property <string> description-text;
    in-out property <string> category-id;
    in-out property <string> new-category-text;
    in property <[MatchRow]> match-rows;
    in property <[string]> category-names;
    in property <[string]> category-filter-names;
    in-out property <int> category-filter-index: 0;
    in-out property <int> editor-category-index: 0;

    callback request-tab-switch(int);
    callback confirm-discard();
    callback cancel-discard();
    callback draft-changed();
    // Open existing configuration (adopt, zero writes).
    callback browse-config();
    // Create new configuration in an empty folder (scaffold).
    callback create-config();
    // Advanced: copy current tree to another empty folder.
    callback choose-folder();
    callback migrate();
    callback open-config();
    callback export-backup();
    callback import-backup();
    callback confirm-import();
    callback cancel-import();
    callback new-match();
    callback select-match(string);
    callback save-match();
    callback delete-match(string);
    callback open-match-file(string);
    callback undo-delete();
    callback commit-deletion();
    callback apply-filter(string);
    callback apply-category-filter(int);
    callback editor-category-changed(int);
    callback add-category();

    VerticalBox {
        padding: 18px;
        spacing: 12px;

        Text {
            text: "Espanso Settings";
            font-size: 26px;
            font-weight: 700;
            color: #172033;
        }
        Text {
            text: "Config: " + root.config-path + "  |  " + root.source-label;
            color: #526078;
            overflow: elide;
        }

        if root.error-message != "": Rectangle {
            background: #feeceb;
            border-color: #e5484d;
            border-width: 1px;
            border-radius: 6px;
            min-height: 44px;
            Text {
                text: root.error-message;
                color: #a8242a;
                wrap: word-wrap;
                vertical-alignment: center;
                x: 12px;
                width: parent.width - 24px;
            }
        }

        HorizontalBox {
            spacing: 8px;
            Button {
                text: "Settings";
                primary: root.active-tab == 0;
                clicked => { root.request-tab-switch(0); }
            }
            Button {
                text: "Configuration";
                primary: root.active-tab == 1;
                clicked => { root.request-tab-switch(1); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.status-message; color: #526078; vertical-alignment: center; }
        }

        if root.confirm-discard-visible: Rectangle {
            background: #fff8df;
            border-color: #d6a100;
            border-width: 1px;
            border-radius: 6px;
            min-height: 58px;
            HorizontalBox {
                padding: 8px;
                Text {
                    text: "You have unsaved changes. Discard them and switch tabs?";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button { text: "Keep editing"; clicked => { root.cancel-discard(); } }
                Button { text: "Discard changes"; clicked => { root.confirm-discard(); } }
            }
        }

        if root.active-tab == 0: VerticalBox {
            spacing: 12px;
            Rectangle {
                background: white;
                border-radius: 8px;
                border-color: #dce2eb;
                border-width: 1px;
                vertical-stretch: 1;
                VerticalBox {
                    padding: 18px;
                    spacing: 12px;
                    Text { text: "Configuration directory"; font-size: 20px; font-weight: 600; color: #172033; }
                    Text {
                        text: "Open points at a folder that already has config/ and match/. Create needs an empty folder. Export and Import use a portable backup file for migration between machines.";
                        color: #526078;
                        wrap: word-wrap;
                    }
                    HorizontalBox {
                        spacing: 8px;
                        LineEdit {
                            text: root.config-path;
                            read-only: true;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "...";
                            enabled: root.can-change-location;
                            clicked => { root.browse-config(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Button {
                            text: "Open existing configuration...";
                            enabled: root.can-change-location;
                            clicked => { root.browse-config(); }
                        }
                        Button {
                            text: "Create new configuration...";
                            enabled: root.can-change-location;
                            clicked => { root.create-config(); }
                        }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        Button {
                            text: "Export backup...";
                            clicked => { root.export-backup(); }
                        }
                        Button {
                            text: "Import backup...";
                            enabled: root.can-change-location;
                            clicked => { root.import-backup(); }
                        }
                        Button { text: "Open current directory"; clicked => { root.open-config(); } }
                    }
                    if !root.can-change-location: Text {
                        text: "The path is currently overridden by the command line or an environment variable, so it cannot be changed permanently.";
                        color: #a15c00;
                    }
                    if root.import-summary != "": VerticalBox {
                        spacing: 8px;
                        Text { text: root.import-summary; color: #172033; wrap: word-wrap; }
                        HorizontalBox {
                            spacing: 8px;
                            Button {
                                text: "Restore and switch";
                                enabled: root.import-ready;
                                clicked => { root.confirm-import(); }
                            }
                            Button {
                                text: "Cancel import";
                                clicked => { root.cancel-import(); }
                            }
                        }
                    }
                    Button {
                        text: root.advanced-open ? "Hide advanced" : "Show advanced";
                        clicked => { root.advanced-open = !root.advanced-open; }
                    }
                    if root.advanced-open: VerticalBox {
                        spacing: 8px;
                        Text {
                            text: "Copy the current configuration into another empty folder, then switch to it. The old directory is left in place. Prefer Export/Import for backups and machine-to-machine moves.";
                            color: #526078;
                            wrap: word-wrap;
                        }
                        Button {
                            text: "Copy to another empty folder...";
                            enabled: root.can-change-location;
                            clicked => { root.choose-folder(); }
                        }
                        if root.selected-path != "": VerticalBox {
                            spacing: 8px;
                            Text { text: "Target directory: " + root.selected-path; color: #172033; }
                            Text { text: root.migration-summary; color: #526078; wrap: word-wrap; }
                            Button {
                                text: "Copy and switch";
                                enabled: root.migration-ready;
                                clicked => { root.migrate(); }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        if root.active-tab == 1: HorizontalBox {
            spacing: 12px;
            Rectangle {
                background: white;
                border-radius: 8px;
                border-color: #dce2eb;
                border-width: 1px;
                horizontal-stretch: 1;
                VerticalBox {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalBox {
                        LineEdit {
                            text <=> root.filter-text;
                            placeholder-text: "Search name, trigger, text, notes";
                            horizontal-stretch: 1;
                        }
                        Button { text: "Search"; clicked => { root.apply-filter(root.filter-text); } }
                    }
                    HorizontalBox {
                        Text { text: "Category"; color: #526078; vertical-alignment: center; }
                        ComboBox {
                            model: root.category-filter-names;
                            current-index <=> root.category-filter-index;
                            horizontal-stretch: 1;
                            selected => { root.apply-category-filter(root.category-filter-index); }
                        }
                    }
                    Button { text: "New match"; clicked => { root.new-match(); } }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalBox {
                            spacing: 6px;
                            for row in root.match-rows: Rectangle {
                                min-height: 64px;
                                background: row.editable ? #f8f9fc : #f2f4f8;
                                border-radius: 5px;
                                HorizontalBox {
                                    padding: 8px;
                                    VerticalBox {
                                        horizontal-stretch: 1;
                                        Text { text: row.title; font-weight: 600; color: #172033; overflow: elide; }
                                        Text {
                                            text: row.trigger == "" ? row.preview : (row.trigger + "  ·  " + row.preview);
                                            color: #69758a;
                                            overflow: elide;
                                        }
                                        if row.category != "": Text {
                                            text: row.category;
                                            color: #3b5bdb;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                        if !row.editable: Text {
                                            text: row.source-label + " · " + row.note;
                                            color: #8a6a1f;
                                            font-size: 12px;
                                            overflow: elide;
                                        }
                                    }
                                    if row.editable: Button { text: "Edit"; clicked => { root.select-match(row.id); } }
                                    if row.editable: Button { text: "Delete"; clicked => { root.delete-match(row.id); } }
                                    if !row.editable: Button { text: "Open file"; clicked => { root.open-match-file(row.source-path); } }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                background: white;
                border-radius: 8px;
                border-color: #dce2eb;
                border-width: 1px;
                horizontal-stretch: 2;
                VerticalBox {
                    padding: 16px;
                    spacing: 8px;
                    Text { text: root.selected-id == "" ? "New match" : "Edit match"; font-size: 20px; font-weight: 600; }
                    Text { text: "Short name"; color: #526078; }
                    LineEdit {
                        text <=> root.short-name-text;
                        placeholder-text: "e.g. Ticket signature";
                        edited => { root.draft-changed(); }
                    }
                    Text { text: "Trigger text"; color: #526078; }
                    LineEdit {
                        text <=> root.trigger-text;
                        placeholder-text: ":hello";
                        edited => { root.draft-changed(); }
                    }
                    Text { text: "Replacement text"; color: #526078; }
                    TextEdit {
                        text <=> root.replacement-text;
                        vertical-stretch: 1;
                        edited => { root.draft-changed(); }
                    }
                    Text { text: "Description"; color: #526078; }
                    TextEdit {
                        text <=> root.description-text;
                        min-height: 64px;
                        edited => { root.draft-changed(); }
                    }
                    Text { text: "Category"; color: #526078; }
                    ComboBox {
                        model: root.category-names;
                        current-index <=> root.editor-category-index;
                        selected => { root.editor-category-changed(root.editor-category-index); }
                    }
                    HorizontalBox {
                        spacing: 8px;
                        LineEdit {
                            text <=> root.new-category-text;
                            placeholder-text: "New category name";
                            horizontal-stretch: 1;
                        }
                        Button { text: "Add category"; clicked => { root.add-category(); } }
                    }
                    HorizontalBox {
                        Text { text: "Supports multiple lines, emoji and CJK characters"; color: #69758a; horizontal-stretch: 1; }
                        if root.undo-visible: Button { text: "Undo delete"; clicked => { root.undo-delete(); } }
                        if root.undo-visible: Button { text: "Save deletion"; clicked => { root.commit-deletion(); } }
                        Button { text: "Save match"; primary: true; clicked => { root.save-match(); } }
                    }
                }
            }
        }
    }
}
